# Copy to .env and fill in, or just export these in your shell.
# .env is gitignored - never commit a real key.

# Issue a key at https://ticketwavehq.com/dashboard/settings/api-keys
# Live keys look like: tw_live_xxxxxxxxxxxxxxxx
TICKETWAVE_API_KEY=

# Optional. Defaults to the canonical public base URL.
# Dashboard alias https://ticketwavehq.com hits the same deployment.
# TICKETWAVE_BASE_URL=https://access.ticketwavehq.com

# Optional inputs used by individual examples:
# EVENT_SLUG=summer-jam-2026
# ACTOR_ID=00000000-0000-0000-0000-000000000000
